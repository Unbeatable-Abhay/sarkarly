# --- LLM providers (at least one is required) ---
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Search ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Server ---
HOST=0.0.0.0
PORT=8000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Leave unset only for local development - it defaults to "*" (open) and
# logs a warning. ALWAYS set this explicitly in production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Limits ---
SCHEME_MATCH_DAILY_LIMIT=50 per day
SCHEME_DIRECTORY_DAILY_LIMIT=50 per day
SCHEME_DETAILS_DAILY_LIMIT=20 per day
LEGAL_ADVISORY_DAILY_LIMIT=20 per day
